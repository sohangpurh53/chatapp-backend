# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatapp
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_make_it_long_and_random

# Google Sign-In (OAuth 2.0 Web client ID from Firebase/Google Cloud Console)
GOOGLE_CLIENT_ID=

# Email (password reset codes). Any SMTP provider works: Resend, SendGrid, SES, Gmail...
# Without SMTP_HOST, development prints the email to the console and production refuses to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ChatApp <no-reply@example.com>"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# WebRTC Configuration (Optional TURN Server for production)
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_PASSWORD=

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chatapp-media
MINIO_PUBLIC_URL=

# File Upload Limits (in bytes)
MAX_IMAGE_SIZE=10485760      # 10 MB
MAX_VIDEO_SIZE=10485760      # 10 MB
MAX_AUDIO_SIZE=10485760      # 10 MB
MAX_DOCUMENT_SIZE=52428800   # 50 MB

# CORS Configuration
CORS_ORIGIN=*

# APK Upload Security Configuration
APK_UPLOAD_SECRET_KEY=your_64_bit_encrypted_secret_key_here_make_it_very_secure_and_random

# AI & Models (Settings > AI & Models)
# 32-byte key that encrypts users' provider API keys at rest. Generate with
#   npm run generate-ai-key
# Without it, providers that need an API key cannot be saved.
AI_CREDENTIALS_KEY=
# Old keys during rotation (comma-separated); they are only used to decrypt.
AI_CREDENTIALS_KEY_PREVIOUS=
# Allow Ollama/custom endpoints on loopback or private networks (self-hosted
# models next to this server). Keep false on a shared server.
AI_ALLOW_PRIVATE_ENDPOINTS=false
# Per-request timeout for AI providers, in milliseconds
AI_REQUEST_TIMEOUT_MS=30000
# Maximum provider configurations per user
AI_MAX_PROVIDERS_PER_USER=20

# Required to read GET /api/app-logs (header: x-app-logs-key)
APP_LOGS_KEY=
