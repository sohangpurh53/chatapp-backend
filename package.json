{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "Chat app backend with Socket.IO and PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:worker": "node workers/notificationWorker.js",
    "start:message-worker": "node workers/messageWorker.js",
    "start:call-worker": "node workers/callEventWorker.js",
    "start:all-workers": "npm run start:worker & npm run start:message-worker & npm run start:call-worker",
    "init-db": "node scripts/init-db.js",
    "test-api": "node test-api.js",
    "test-socket": "node test-socket.js",
    "test-notifications": "node test-notifications.js",
    "test-offline-calling": "node scripts/test-offline-calling.js",
    "test-fcm-notifications": "node scripts/test-fcm-notifications.js",
    "verify-fixes": "node scripts/verify-offline-calling-fix.js",
    "cleanup-signals": "node scripts/cleanup-expired-signals.js",
    "generate-apk-key": "node scripts/generate-apk-key.js",
    "test-apk-upload": "node test-apk-upload.js",
    "test": "node --require ./__tests__/setup.js --test \"__tests__/**/*.test.js\"",
    "test:ai": "node --require ./__tests__/setup.js --test \"__tests__/ai/*.test.js\"",
    "test:games": "node --require ./__tests__/setup.js --test \"__tests__/games/*.test.js\"",
    "generate-ai-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
  "keywords": [
    "chat",
    "socket.io",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.65.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^11.3.1",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "minio": "^8.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "axios": "^1.21.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.1"
  },
  "overrides": {
    "uuid": "$uuid",
    "minio": {
      "query-string": {
        "decode-uri-component": "^0.5.1"
      }
    },
    "nodemon": {
      "minimatch": "^11.0.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
