{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "Chat app backend with Socket.IO and PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:worker": "node workers/notificationWorker.js",
    "start:message-worker": "node workers/messageWorker.js",
    "start:call-worker": "node workers/callEventWorker.js",
    "start:all-workers": "npm run start:worker & npm run start:message-worker & npm run start:call-worker",
    "init-db": "node scripts/init-db.js",
    "test-api": "node test-api.js",
    "test-socket": "node test-socket.js",
    "test-notifications": "node test-notifications.js",
    "test-offline-calling": "node scripts/test-offline-calling.js",
    "cleanup-signals": "node scripts/cleanup-expired-signals.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "chat",
    "socket.io",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^5.23.0",
    "@bull-board/express": "^5.23.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.65.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "minio": "^8.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "redis": "^4.7.1",
    "sequelize": "^6.37.7",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "axios": "^1.13.2",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.1"
  }
}
